---
import Site from '../layouts/Site.astro';

const features = [
  { title: 'Measure with one hand', text: 'Big numbers, a keyboard strip and guided series that wait for each key.' },
  { title: 'Reads the curve for you', text: 'Damper and pedal, let-off in the window, friction by section and keys that stand out from their neighbours.' },
  { title: 'Your targets', text: 'Start from factory specs and shape ranges or slopes key by key.' },
  { title: 'Before and after', text: 'Several runs per piano, compared in the charts, per key and as a table of changes.' },
  { title: 'Calibrated to test weights', text: 'Measure a few keys with brass weights once. Every reading is then shown the way weights would read it.' },
  { title: 'Same files as before', text: 'Opens and saves the JSON and CSV files of the original interface.' },
];

// Install guide per device. Steps: a short title, then what to do and what you see.
const KMD_WIFI = [
  { title: 'Switch the KMD on in WiFi mode.', text: 'Set it down upright and still. Hold the top button while you switch it on, and let go when the display shows <b>WiFi mode</b>.' },
];
const kmdStall = { q: 'The KMD stops answering after a break', a: 'After 20 minutes without use the KMD saves power. Switch it off, wait a full minute and switch it on again in WiFi mode.' };

const guides = [
  {
    id: 'computer',
    tab: 'Computer',
    need: '<b>Chrome</b> or <b>Edge</b>, version 147 or newer. Nothing to install besides the browser.',
    setup: [
      { title: 'Open KMDash.', text: 'Open it in Chrome or Edge.', action: { label: 'Open KMDash', href: '/app/' } },
      { title: 'Install it as an app.', text: 'Click the install icon at the right end of the address bar, or choose <b>Install KMDash</b> in the browser menu. KMDash gets its own window and icon, and opens without internet.' },
    ],
    piano: [
      ...KMD_WIFI,
      { title: 'Join the KMD WiFi.', text: 'Its name is <b>KMD-</b> and the serial number, the password is in the KMD manual. The computer shows no internet, that is expected.' },
      { title: 'Open KMDash and allow the connection.', text: 'The first time, the browser asks whether KMDash may find and connect to devices on your local network. Choose <b>Allow</b>. The status at the top turns to <b>Connected</b>.' },
    ],
    update: 'KMDash updates itself whenever you open it with internet.',
    trouble: [
      { q: 'It says “Not connected to the KMD”', a: 'Check that the KMD is in WiFi mode and the computer is on its WiFi. If the computer keeps jumping back to another network, turn off automatic joining for that network.' },
      { q: 'It says “The browser blocks the connection”', a: 'The local network was not allowed. Click the icon left of the address, open the site settings and allow local network access. Then choose <b>Help</b>, <b>Try again</b> in KMDash.' },
      { q: 'It says “This browser cannot reach the KMD”', a: 'Safari and Firefox do not let a website reach the KMD. Use Chrome or Edge. If you prefer to stay with Safari on a Mac or with Firefox, set up the userscript as on a phone: the <b>Userscripts</b> app for Safari, <b>Violentmonkey</b> for Firefox, then open <code>http://192.168.1.67</code> at the piano.' },
      kmdStall,
    ],
  },
  {
    id: 'ios',
    tab: 'iPhone and iPad',
    need: '<b>Safari</b> on iOS 15.1 or newer and the free app <b>Userscripts</b>. It runs KMDash on the KMD’s own page.',
    setup: [
      { title: 'Install Userscripts.', text: 'Get the free app from the App Store and open it once.', action: { label: 'Userscripts in the App Store', href: 'https://apps.apple.com/app/userscripts/id1463298887', external: true } },
      { title: 'Turn on the extension.', text: 'In Settings, open <b>Apps</b>, <b>Safari</b>, <b>Extensions</b>, <b>Userscripts</b> (on older iOS: <b>Safari</b>, <b>Extensions</b>). Turn on <b>Allow Extension</b> and set <b>Other Websites</b> to <b>Allow</b>.' },
      { title: 'Install KMDash.', text: 'Open this page in Safari, tap the button below. Safari shows the script as text. Tap the extensions button in the address bar (a puzzle piece, on newer iOS inside the <b>⋯</b> menu), choose <b>Userscripts</b> and tap <b>Install</b>.', action: { label: 'Install the userscript', href: '/kmdash.user.js' } },
    ],
    piano: [
      ...KMD_WIFI,
      { title: 'Join the KMD WiFi.', text: 'In Settings, WiFi, choose <b>KMD-</b> and the serial number, the password is in the KMD manual. The iPhone shows <b>No Internet Connection</b>, stay on it.' },
      { title: 'Open the KMD page in Safari.', text: 'Type <code>http://192.168.1.67</code>. KMDash appears instead of the original interface. Add a bookmark for next time. Use Safari itself, not an icon on the Home Screen, because extensions only run in Safari.' },
    ],
    update: 'To update, open the install link again and install over the old version. Your pianos stay.',
    keep: 'Safari can delete the data of a page you have not opened for about a week of Safari use. After each job, save the piano as a file: Piano tab, <b>Save file</b>.',
    trouble: [
      { q: 'The original interface appears', a: 'The extension is not running on this page. Tap the extensions button, choose <b>Userscripts</b> and allow it for this website. In the Userscripts app, check that KMDash is switched on.' },
      { q: 'The page does not load', a: 'The iPhone may have joined another WiFi it knows. Join the KMD WiFi again and turn off <b>Auto-Join</b> for other networks nearby. Type the address with <code>http://</code>.' },
      kmdStall,
    ],
  },
  {
    id: 'android',
    tab: 'Android',
    need: '<b>Firefox</b> and its free extension <b>Violentmonkey</b>. Chrome on Android cannot run extensions. It runs KMDash on the KMD’s own page.',
    setup: [
      { title: 'Install Firefox.', text: 'From Google Play.', action: { label: 'Firefox on Google Play', href: 'https://play.google.com/store/apps/details?id=org.mozilla.firefox', external: true } },
      { title: 'Add Violentmonkey.', text: 'In Firefox open the menu <b>⋮</b>, then <b>Extensions</b> (or <b>Add-ons</b>), find <b>Violentmonkey</b> and add it. Tampermonkey works as well.' },
      { title: 'Install KMDash.', text: 'Open this page in Firefox, tap the button below. Violentmonkey shows the script, tap <b>Install</b>.', action: { label: 'Install the userscript', href: '/kmdash.user.js' } },
      { title: 'Keep the phone on a WiFi without internet.', text: 'Android likes to switch to mobile data when a WiFi has no internet. Turn that off in the WiFi settings (on Samsung under <b>Intelligent Wi-Fi</b>), or simply turn off mobile data while you measure.' },
    ],
    piano: [
      ...KMD_WIFI,
      { title: 'Join the KMD WiFi.', text: 'Choose <b>KMD-</b> and the serial number, the password is in the KMD manual. When Android says the network has no internet, choose to stay connected.' },
      { title: 'Open the KMD page in Firefox.', text: 'Type <code>http://192.168.1.67</code>. KMDash appears instead of the original interface. If Firefox offers a secure version first, choose to continue to the HTTP site.' },
    ],
    update: 'To update, open the install link again and confirm. Your pianos stay.',
    trouble: [
      { q: 'The original interface appears', a: 'Violentmonkey is off or KMDash is switched off in it. Open the menu <b>⋮</b>, <b>Extensions</b>, <b>Violentmonkey</b> and check both.' },
      { q: 'The page does not load', a: 'The phone is probably using mobile data. Turn off mobile data, stay on the KMD WiFi and open the page again.' },
      kmdStall,
    ],
  },
];

const safety = [
  { title: 'It listens', text: 'Readings arrive from the KMD on their own. KMDash only asks for the settings when you open them.' },
  { title: 'Only known commands', text: 'It can send exactly the commands of the original interface, in the same format. Anything else is blocked in the code.' },
  { title: 'Changes need you', text: 'Settings only after they were read from the KMD, only what you changed, with a summary first. Sensor calibration and factory reset need two confirmations.' },
  { title: 'Nothing on the device', text: 'No firmware, no install on the KMD. Remove the app or the userscript and everything is as before.' },
  { title: 'Data stays with you', text: 'Pianos and runs live in the browser of each device. Save a file after each job as a backup.' },
  { title: 'Charge carefully', text: 'Only use the supplied 5 V charger. The manual warns that other chargers can damage the KMD and are not covered by the warranty.' },
];

const faq = [
  { q: 'Why an app on the computer, and a userscript on the phone?', a: 'The KMD talks over its own WiFi without encryption, and browsers do not let a secure website reach such a device. Chrome and Edge make an exception once you allow access to the local network, so on a computer KMDash runs straight from this site. Safari and Firefox have no such exception. On a phone, the userscript runs inside the KMD’s own page, where the limit does not apply. No app store, no account.' },
  { q: 'Does it change anything on my KMD?', a: 'Only when you change settings, calibrate the sensor or restore factory settings yourself, each with confirmation. Nothing is installed on the device.' },
  { q: 'Why do my values differ from test weights?', a: 'The KMD averages over 2 to 4 mm of key travel at constant speed. Technicians report down weight a few grams higher and friction up to 6 to 8 g higher, while balance agrees. Calibrate with test weights once and KMDash converts all readings.' },
  { q: 'What does the damper warning mean?', a: 'Touchweight is usually measured with the right pedal pressed. If it is not, the damper shows up as a step in the curve and can reach into the measuring window, so down and up weight read too high.' },
  { q: 'Where is my data?', a: 'In the browser of each device: on the computer with KMDash, on the phone with the KMD’s page. Save a file after each job. It also opens in the original interface.' },
  { q: 'Can I use my phone and my computer for the same piano?', a: 'Yes. Save the piano as a file on one device (Piano tab, <b>Save file</b>) and open it on the other (<b>Open file</b>).' },
  { q: 'Can I still use the original interface?', a: 'Yes. Piano tab, then Open original interface. On a phone you can also add <code>#original</code> to the address and reload the page to come back.' },
  { q: 'Which pianos have targets built in?', a: 'Touch weight from published factory documents: Steinway grands and uprights (New York and Hamburg), C. Bechstein, Fazioli, Petrof and Schimmel. Key dip only, because the makers publish no touch weight: Yamaha, Kawai, Seiler, Mason & Hamlin and Blüthner. Plus general values for grands and uprights. Choose a model when you add a piano, or later under Targets. Everything can be edited.' },
  { q: 'Does it work on iPad or a laptop?', a: 'Yes. On a wide screen you see the whole keyboard, the values and a large curve side by side. The arrow keys move between keys. On a laptop KMDash runs in Chrome or Edge, on an iPad with the userscript.' },
];
---

<Site title="KMDash">
  <main>
    <section class="hero wrap">
      <div class="hero-text">
        <p class="eyebrow">For the Renner Key Measuring Device</p>
        <h1>The KMD, made for your phone.</h1>
        <p class="lead">KMDash replaces the built-in interface of the Renner Key Measuring Device with a calm view for one hand, and a roomy one on a laptop. Guided measuring, clear hints and before and after, right at the piano.</p>
        <div class="actions">
          <a class="button primary" href="/demo/">Try the demo</a>
          <a class="button" href="#install">Install</a>
        </div>
        <p class="small">Works offline on the KMD WiFi. Nothing is installed on the KMD.</p>
      </div>
      <div class="phone" aria-hidden="true">
        <iframe src="/demo/" title="KMDash demo" loading="lazy" tabindex="-1"></iframe>
      </div>
    </section>

    <div class="keys" aria-hidden="true">
      <svg width="100%" height="64">
        <defs>
          <pattern id="octave" width="168" height="64" patternUnits="userSpaceOnUse">
            <rect width="168" height="64" style="fill: var(--key-white)" />
            {[1, 2, 3, 4, 5, 6, 7].map((i) => <line x1={i * 24 - 0.5} x2={i * 24 - 0.5} y1="0" y2="64" style="stroke: var(--border)" />)}
            {[17, 41, 89, 113, 137].map((x) => <rect x={x} width="14" height="38" style="fill: var(--key-black)" />)}
          </pattern>
        </defs>
        <rect width="100%" height="64" fill="url(#octave)" />
        <rect width="100%" height="3" style="fill: var(--accent)" />
      </svg>
    </div>

    <section class="wrap block">
      <h2>What it does</h2>
      <ol class="features">
        {
          features.map((f, i) => (
            <li>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="wrap block" id="install">
      <h2>Install</h2>
      <p class="intro">Set it up once, at home with internet. At the piano your phone or computer is on the KMD’s WiFi, without internet, and KMDash works all the same.</p>
      <div class="tabs" role="tablist" aria-label="Device">
        {guides.map((g, i) => <button type="button" role="tab" id={`tab-${g.id}`} aria-controls={`guide-${g.id}`} aria-selected={i === 0 ? 'true' : 'false'} data-tab={g.id}>{g.tab}</button>)}
      </div>
      {
        guides.map((g) => (
          <div class="guide" role="tabpanel" id={`guide-${g.id}`} aria-labelledby={`tab-${g.id}`} data-guide={g.id}>
            <h3 class="guide-title">{g.tab}</h3>
            <p class="need"><span class="label">You need</span><span set:html={g.need} /></p>
            <div class="guide-cols">
              <div>
                <h4 class="step-title">Once, at home</h4>
                <ol class="numbered steps">
                  {g.setup.map((s) => (
                    <li>
                      <b>{s.title}</b> <span set:html={s.text} />
                      {s.action && (
                        <a class={`button step-action${s.action.external ? '' : ' primary'}`} href={s.action.href} {...(s.action.external ? { target: '_blank', rel: 'noopener' } : {})}>
                          {s.action.label}
                        </a>
                      )}
                    </li>
                  ))}
                </ol>
              </div>
              <div>
                <h4 class="step-title">At the piano</h4>
                <ol class="numbered steps">
                  {g.piano.map((s) => (
                    <li>
                      <b>{s.title}</b> <span set:html={s.text} />
                    </li>
                  ))}
                </ol>
                <p class="small" set:html={g.update} />
                {g.keep && <p class="keep" set:html={g.keep} />}
              </div>
            </div>
            <h4 class="step-title">If something does not work</h4>
            <div class="faq">
              {g.trouble.map((item) => (
                <details>
                  <summary>{item.q}</summary>
                  <p set:html={item.a} />
                </details>
              ))}
            </div>
          </div>
        ))
      }
      <script is:inline>
        // Shows the guide for this device first; without JavaScript all three stay open one below the other
        (() => {
          const root = document.getElementById('install');
          const tabs = [...root.querySelectorAll('[role=tab]')];
          const ua = navigator.userAgent;
          const guess = /iPhone|iPad/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1) ? 'ios' : /Android/.test(ua) ? 'android' : 'computer';
          const show = (id) => {
            for (const tab of tabs) tab.setAttribute('aria-selected', String(tab.dataset.tab === id));
            for (const panel of root.querySelectorAll('[data-guide]')) panel.hidden = panel.dataset.guide !== id;
          };
          root.classList.add('tabbed');
          tabs.forEach((tab) => tab.addEventListener('click', () => show(tab.dataset.tab)));
          show(guess);
        })();
      </script>
    </section>

    <section class="wrap block" id="safety">
      <h2>Careful with your KMD</h2>
      <ul class="safety">
        {
          safety.map((s) => (
            <li>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="wrap block" id="faq">
      <h2>Questions</h2>
      <div class="faq">
        {
          faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p set:html={item.a} />
            </details>
          ))
        }
      </div>
    </section>
  </main>
</Site>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    padding-top: 56px;
    padding-bottom: 48px;
  }
  .eyebrow {
    margin-bottom: 18px;
    font: 600 11px var(--font);
    color: var(--text-2);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }
  h1 {
    font: var(--w-figure) clamp(42px, 7.5vw, 76px)/1.04 var(--font);
    letter-spacing: -0.02em;
  }
  .lead {
    margin-top: 24px;
    max-width: 32em;
    font-size: 19px;
    line-height: 1.55;
    color: var(--text-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 24px;
    border: 1px solid var(--text-1);
    border-radius: 2px;
    color: var(--text-1);
    font: 500 15px var(--font);
    letter-spacing: 0.01em;
    transition: background 0.15s, color 0.15s;
  }
  .button:hover {
    background: var(--fill-1);
  }
  .button.primary {
    background: var(--text-1);
    color: var(--bg);
  }
  .button.primary:hover {
    background: color-mix(in srgb, var(--text-1) 86%, var(--bg));
  }
  .small {
    margin-top: 16px;
    font-size: 14px;
    color: var(--text-3);
  }
  .phone {
    display: none;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 340px;
      padding-top: 88px;
      padding-bottom: 72px;
    }
    .phone {
      display: block;
      width: 336px;
      height: 674px;
      padding: 10px;
      border-radius: 50px;
      background: #111;
      box-shadow: 0 40px 90px rgb(0 0 0 / 0.2), 0 0 0 1px rgb(0 0 0 / 0.4);
    }
    .phone iframe {
      width: 395px;
      height: 817px;
      border: 0;
      border-radius: 50px;
      transform: scale(0.8);
      transform-origin: 0 0;
      background: var(--bg);
    }
  }
  /* A strip of keys with the red felt, between the introduction and the rest */
  .keys svg {
    display: block;
  }
  .keys {
    border-bottom: 1px solid var(--border);
  }
  .block {
    padding-top: 80px;
  }
  h2 {
    margin-bottom: 28px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    font: 400 clamp(30px, 4.5vw, 40px)/1.1 var(--font);
    letter-spacing: -0.01em;
  }
  .intro {
    max-width: 36em;
    margin: -8px 0 28px;
    color: var(--text-2);
  }
  .features,
  .safety {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .features li,
  .safety li {
    padding: 20px 0 28px;
    border-top: 1px solid var(--border);
  }
  .num {
    display: block;
    margin-bottom: 14px;
    font: 500 14px var(--font);
    color: var(--accent);
  }
  .features h3,
  .safety h3 {
    margin-bottom: 8px;
    font: 500 20px/1.3 var(--font);
  }
  .features p,
  .safety p {
    font-size: 16px;
    color: var(--text-2);
  }
  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0 40px;
  }
  .panel {
    padding: 18px 0 24px;
    border-top: 1px solid var(--border);
  }
  .panel h3 {
    margin-bottom: 14px;
    font: 500 20px/1.3 var(--font);
  }
  /* Steps numbered in the serif */
  .numbered {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    color: var(--text-2);
    font-size: 16px;
  }
  .numbered li {
    position: relative;
    padding-left: 32px;
    counter-increment: step;
  }
  .numbered li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    font: 600 15px/1.6 var(--font);
    color: var(--text-1);
  }
  .numbered li + li {
    margin-top: 12px;
  }
  .numbered :global(b) {
    font-weight: 600;
    color: var(--text-1);
  }
  /* Install guide: one device at a time. The red line marks the open one. Without JavaScript all are shown. */
  .tabs {
    display: none;
    gap: 4px;
    margin: 0 0 32px;
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
  }
  .tabbed .tabs {
    display: flex;
  }
  .tabs button {
    flex: none;
    min-height: 48px;
    margin-bottom: -1px;
    padding: 0 16px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--text-2);
    font: 500 16px var(--font);
    cursor: pointer;
  }
  .tabs button:first-child {
    padding-left: 0;
  }
  .tabs button[aria-selected='true'] {
    border-bottom-color: var(--accent);
    color: var(--text-1);
  }
  .guide + .guide {
    margin-top: 56px;
  }
  .tabbed .guide + .guide {
    margin-top: 0;
  }
  .guide-title {
    margin-bottom: 16px;
    font: 500 24px/1.2 var(--font);
  }
  .tabbed .guide-title {
    display: none;
  }
  .need {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    max-width: 46em;
    margin-bottom: 36px;
    font-size: 16px;
    color: var(--text-2);
  }
  .need :global(b) {
    font-weight: 600;
    color: var(--text-1);
  }
  .label {
    font: 600 11px/1.9 var(--font);
    color: var(--text-2);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }
  .guide-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 8px 56px;
  }
  .step-title {
    margin: 0 0 18px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    font: 600 11px var(--font);
    color: var(--text-2);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }
  .guide > .step-title {
    margin-top: 44px;
  }
  .steps {
    margin-bottom: 24px;
  }
  .steps li + li {
    margin-top: 18px;
  }
  .step-action {
    display: flex;
    width: fit-content;
    min-height: 44px;
    margin-top: 12px;
    padding: 0 18px;
    font-size: 14px;
  }
  .keep {
    margin-top: 16px;
    padding: 12px 14px;
    border-left: 2px solid var(--accent);
    background: var(--fill-1);
    font-size: 15px;
    color: var(--text-2);
  }
  .keep :global(b) {
    font-weight: 600;
    color: var(--text-1);
  }
  .faq {
    border-bottom: 1px solid var(--border);
  }
  details {
    border-top: 1px solid var(--border);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 18px 0;
    font: 500 18px/1.4 var(--font);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    flex: none;
    font: 300 24px/1 var(--font);
    color: var(--text-3);
    transition: transform 0.2s;
  }
  details[open] summary::after {
    transform: rotate(45deg);
  }
