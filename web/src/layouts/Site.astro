---
// Site layout: the app's own fonts, no external requests
import geist from '../app/fonts/geist.woff2?url';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'A calm interface for the Renner Key Measuring Device, for phone and laptop.' } = Astro.props;
const fonts = `@font-face{font-family:'KMDashboard Sans';src:url(${geist}) format('woff2');font-weight:100 900;font-display:swap}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f5f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f0e" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Fragment set:html={`<style>${fonts}</style>`} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">KMD<span>ashboard</span></a>
      <nav>
        <a href="/#install">Install</a>
        <a href="/#faq">Questions</a>
        <a class="cta" href="/demo/">Demo</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <p>Unofficial and open source (MIT). Not affiliated with Renner or the makers of the KMD. Renner and KMD are names of their respective owners.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --w-figure: 500;
    --font: 'KMDashboard Sans', -apple-system, BlinkMacSystemFont, system-ui, 'Segoe UI', Roboto, sans-serif;
    --bg: #f6f5f0;
    --surface: #fbfaf7;
    --text-1: #141414;
    --text-2: #55544f;
    --text-3: #6f6d66;
    --border: rgb(20 20 20 / 0.13);
    --rule: #141414;
    --fill-1: rgb(20 20 20 / 0.045);
    --accent: #b8322a;
    --key-white: #fdfdfa;
    --key-black: #161616;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f0f0e;
      --surface: #181817;
      --text-1: #f1efe8;
      --text-2: #b8b5ac;
      --text-3: #8f8d85;
      --border: rgb(241 239 232 / 0.13);
      --rule: #f1efe8;
      --fill-1: rgb(241 239 232 / 0.06);
      --accent: #e2584c;
      --key-white: #e9e6de;
      --key-black: #0a0a0a;
      color-scheme: dark;
    }
  }
  * {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text-1);
    font: 17px/1.55 var(--font);
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  h1,
  h2,
  h3 {
    margin: 0;
    font-weight: 400;
  }
  p {
    margin: 0;
  }
  code {
    padding: 1px 6px;
    border: 1px solid var(--border);
    font: 0.86em ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .wrap {
    width: min(1120px, 100%);
    margin: 0 auto;
    padding: 0 24px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: min(1120px, 100%);
    margin: 0 auto;
    padding: calc(14px + env(safe-area-inset-top)) 24px 14px;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: 7px;
    font: 600 19px/1 var(--font);
  }
  .brand span {
    font: 600 11px/1 var(--font);
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }
  .site-header nav {
    display: flex;
    align-items: center;
    gap: 24px;
    font: 600 11px var(--font);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }
  .site-header nav a {
    color: var(--text-2);
  }
  .site-header nav a:hover {
    color: var(--text-1);
  }
  .site-header nav a.cta {
    padding: 10px 16px;
    border: 1px solid var(--text-1);
    border-radius: 2px;
    color: var(--text-1);
  }
  .site-header nav a.cta:hover {
    background: var(--text-1);
    color: var(--bg);
  }
  .site-footer {
    width: min(1120px, 100%);
    margin: 64px auto 0;
    padding: 24px 24px calc(40px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--border);
    font-size: 13.5px;
    color: var(--text-3);
  }
  @media (max-width: 480px) {
    .site-header nav a:not(.cta) {
      display: none;
    }
  }
</style>
